# Contact form email (Postmark). Copy these into your local .env and into
# Vercel project settings. Never commit real values. The .env file is gitignored.

# Your Postmark Server API token. Postmark dashboard, open your Server,
# then the API Tokens tab. This is a secret and stays on the server only.
POSTMARK_SERVER_TOKEN=

# The From address. This must be a verified Sender Signature in Postmark,
# or any address on a domain you verified there. Example: hello@nabeelmunir.com
CONTACT_FROM_EMAIL=

# Where you want to receive the messages. Example: nabeel.beeni30@gmail.com
CONTACT_TO_EMAIL=

# Optional. The Postmark message stream id. Defaults to outbound if left unset.
POSTMARK_MESSAGE_STREAM=outbound
